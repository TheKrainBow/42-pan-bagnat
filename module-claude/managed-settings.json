{
  "permissions": {
    "allow": [
      "Bash(git status *)", "Bash(git diff *)", "Bash(git log *)", "Bash(git show *)",
      "Bash(git add *)", "Bash(git commit *)", "Bash(git branch *)",
      "Bash(git checkout *)", "Bash(git switch *)", "Bash(git stash *)", "Bash(git fetch *)",
      "Bash(docker ps *)", "Bash(docker logs *)", "Bash(docker inspect *)",
      "Bash(docker compose ps *)", "Bash(docker compose logs *)", "Bash(docker compose config *)"
    ],
    "ask": [
      "Bash(git push *)", "Bash(git pull *)", "Bash(git merge *)", "Bash(git rebase *)",
      "Bash(git reset *)", "Bash(git revert *)",
      "Bash(pb deploy)", "Bash(pb deploy *)", "Bash(pb rebuild)", "Bash(pb rebuild *)",
      "Bash(pb down)", "Bash(pb down *)",
      "Bash(docker compose restart *)", "Bash(docker compose stop *)", "Bash(docker compose start *)",
      "Bash(docker compose rm *)", "Bash(docker compose exec *)", "Bash(docker compose kill *)",
      "Bash(docker restart *)", "Bash(docker stop *)", "Bash(docker start *)", "Bash(docker kill *)",
      "Bash(docker exec *)", "Bash(docker rm *)"
    ],
    "deny": [
      "Bash(git push --force *)", "Bash(git push -f *)", "Bash(git push --force-with-lease *)",
      "Bash(git reset --hard *)", "Bash(git clean *)",
      "Bash(docker compose up *)", "Bash(docker compose build *)", "Bash(docker compose create *)",
      "Bash(docker compose run *)", "Bash(docker compose down *)",
      "Bash(docker build *)", "Bash(docker run *)", "Bash(docker create *)",
      "Bash(docker volume rm *)", "Bash(docker volume prune *)", "Bash(docker system prune *)",
      "Bash(docker rm -f *)",
      "Read(**/.env)", "Read(**/.env.*)", "Read(**/*.dump)",
      "Read(//run/pb/**)", "Edit(//run/pb/**)"
    ],
    "disableBypassPermissionsMode": "disable"
  },
  "allowManagedHooksOnly": true,
  "env": {
    "DISABLE_AUTOUPDATER": "1"
  },
  "hooks": {
    "SessionStart":     [{ "hooks": [{ "type": "command", "command": "/opt/pb/hook.sh session_start", "timeout": 5 }] }],
    "UserPromptSubmit": [{ "hooks": [{ "type": "command", "command": "/opt/pb/hook.sh prompt", "timeout": 5 }] }],
    "Notification":     [{ "hooks": [{ "type": "command", "command": "/opt/pb/hook.sh notification", "timeout": 5 }] }],
    "PostToolUse":      [{ "matcher": "*", "hooks": [{ "type": "command", "command": "/opt/pb/hook.sh tool_done", "timeout": 5 }] }],
    "Stop":             [{ "hooks": [{ "type": "command", "command": "/opt/pb/hook.sh stop", "timeout": 5 }] }],
    "StopFailure":      [{ "hooks": [{ "type": "command", "command": "/opt/pb/hook.sh stop_failure", "timeout": 5 }] }],
    "SessionEnd":       [{ "hooks": [{ "type": "command", "command": "/opt/pb/hook.sh session_end", "timeout": 5 }] }],
    "PreToolUse":       [{ "matcher": "Bash", "hooks": [{ "type": "command", "command": "/opt/pb/guard.sh", "timeout": 10 }] }]
  }
}
